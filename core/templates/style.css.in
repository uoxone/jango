/*
  A quiet first page.
  paper is the room. clay is the one warm mark.
*/

:root {
  --paper: #f6f1e8;
  --ink: #1e1a16;
  --muted: #5f564e;
  --clay: #8f3820;
  color-scheme: light;
}

@media (prefers-color-scheme: dark) {
  :root {
    --paper: #141210;
    --ink: #f3eee7;
    --muted: #b5aca3;
    --clay: #e8b39d;
    color-scheme: dark;
  }
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  color: var(--ink);
  background: var(--paper);
  font: 1.0625rem/1.55 ui-sans-serif, system-ui, "Segoe UI", Cantarell, "Noto Sans", sans-serif;
}

body::before {
  content: "";
  position: fixed;
  inset: 0 0 auto;
  height: 0.18rem;
  background: var(--clay);
}

main {
  width: min(26rem, calc(100% - 3rem));
  margin: 0 auto;
  padding: 22vh 0 12vh;
}

.brand {
  display: inline-block;
  margin: 0 0 2.75rem;
  color: var(--clay);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  line-height: 1;
  text-decoration: none;
  text-transform: uppercase;
}

h1 {
  margin: 0;
  font-family: "Iowan Old Style", Palatino, "Palatino Linotype", "Liberation Serif", "Noto Serif", Georgia, serif;
  font-size: clamp(3.25rem, 10vw, 4.75rem);
  font-weight: 500;
  letter-spacing: -0.045em;
  line-height: 0.92;
}

h1::after {
  content: "";
  display: block;
  width: 2.25rem;
  height: 0.12rem;
  margin-top: 1.25rem;
  background: var(--clay);
}

.where {
  margin: 1.4rem 0 0;
  color: var(--muted);
}

code {
  font-family: ui-monospace, "Cascadia Mono", "Liberation Mono", monospace;
  font-size: 0.92em;
  color: var(--ink);
}

.go {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem 1.35rem;
  margin-top: 2.4rem;
}

.go a {
  color: var(--clay);
  text-decoration-thickness: 1px;
  text-decoration-color: transparent;
  text-underline-offset: 0.22em;
}

.go a.docs {
  color: var(--clay);
  text-decoration-color: var(--clay);
}

.go a:hover { text-decoration-color: currentColor; }

a:focus-visible {
  outline: 2px solid var(--clay);
  outline-offset: 3px;
  border-radius: 0.15rem;
}

::selection {
  background: #f0d2c4;
  color: var(--ink);
}

@media (prefers-color-scheme: dark) {
  ::selection {
    background: #4a332c;
    color: var(--ink);
  }
}

@media (max-width: 32rem) {
  main { padding-top: 16vh; }
}
