[package]
name = "__NAME__"
version = "0.1.0"
edition = "2021"

# -----------------------------------------------
# Only ongo. Nothing from outside this project.
# -----------------------------------------------
[dependencies]
ongo = { path = "__ONGO__" }

# -----------------------------------------------
# Release
# One optimized binary. `ongo build` copies it,
# with static/, into build/. Cargo stays here.
# -----------------------------------------------
[profile.release]
lto = "fat"
codegen-units = 1
opt-level = 3
strip = "symbols"
